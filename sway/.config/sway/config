# Sway config, ported from ~/.config/i3/config
# man 5 sway  |  validate with: sway -C

set $mod Mod4

# Gaps settings
gaps inner 16
gaps outer 8
smart_gaps on
smart_borders on

# Disable title bar
default_border pixel 1
default_floating_border pixel 1

font pango:C64 Pro 8

### Input
input type:keyboard {
    xkb_layout se
}
# Touchpad: libinput defaults, same as under X. Uncomment to taste.
# input type:touchpad {
#     tap enabled
#     natural_scroll enabled
# }

### Outputs
# Wallpaper (acidburn.ppm is a 1x1 #282828 image)
output * bg #282828 solid_color
# Monitor layouts are handled by kanshi (~/.config/kanshi/config),
# replacing autorandr + the udev hotplug rule.

### Autostart
# Imports WAYLAND_DISPLAY etc. into systemd/dbus (needed for portals, screen sharing)
include /etc/sway/config.d/*

# Bar: sway launches waybar itself and handles it across reloads
bar {
    swaybar_command waybar
}

# Monitor profiles: (re)start kanshi on every load/reload. One sh -c so the
# pkill finishes before kanshi starts (Ubuntu's kanshi ships no kanshictl).
exec_always sh -c 'pkill -x kanshi; exec kanshi'

exec dex --autostart --environment sway

# Lock before suspend and on `loginctl lock-session` (replaces xss-lock)
exec swayidle -w \
    lock '~/.local/bin/c64lock-sway' \
    before-sleep '~/.local/bin/c64lock-sway'

exec nm-applet
exec blueman-applet

# Volume keys (work on the lock screen too)
bindsym --locked XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +10%
bindsym --locked XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -10%
bindsym --locked XF86AudioMute exec pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym --locked XF86AudioMicMute exec pactl set-source-mute @DEFAULT_SOURCE@ toggle

# Use Mouse+$mod to drag floating windows
floating_modifier $mod normal
tiling_drag enable

# start a terminal
bindsym $mod+Return exec x-terminal-emulator

# kill focused window
bindsym $mod+Shift+q kill

# program launcher (rofi 2.x is Wayland-native)
bindsym $mod+d exec rofi -show drun

# switch to external monitor / back to laptop
bindsym $mod+Shift+p exec ~/.local/bin/mon-sway

# Screenshots (grim + slurp)
bindsym Print exec mkdir -p ~/Pictures/screenshots && grim ~/Pictures/screenshots/$(date +%Y-%m-%d_%H-%M-%S).png
bindsym $mod+Print exec mkdir -p ~/Pictures/screenshots && grim -g "$(slurp)" ~/Pictures/screenshots/$(date +%Y-%m-%d_%H-%M-%S).png

# change focus
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# move focused window
bindsym $mod+Shift+j move left
bindsym $mod+Shift+k move down
bindsym $mod+Shift+l move up
bindsym $mod+Shift+odiaeresis move right

bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# splits
bindsym $mod+h split h
bindsym $mod+v split v

bindsym $mod+f fullscreen toggle

# layouts
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+a focus parent

# Workspaces
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# reload config (sway has no in-place restart; reload covers it)
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r reload

# Power management
bindsym $mod+Shift+e exec swaynag -t warning -m 'Shutdown?' -B 'Yes' 'systemctl poweroff' -B 'Log out' 'swaymsg exit'

# Lockscreen
bindsym $mod+l exec ~/.local/bin/c64lock-sway

mode "resize" {
        bindsym j resize shrink width 10 px or 10 ppt
        bindsym k resize grow height 10 px or 10 ppt
        bindsym l resize shrink height 10 px or 10 ppt
        bindsym odiaeresis resize grow width 10 px or 10 ppt

        bindsym Left resize shrink width 10 px or 10 ppt
        bindsym Down resize grow height 10 px or 10 ppt
        bindsym Up resize shrink height 10 px or 10 ppt
        bindsym Right resize grow width 10 px or 10 ppt

        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+r mode "default"
}
bindsym $mod+r mode "resize"

# acidburn palette
set $bg          #282828
set $fg          #eaeadc
set $accent      #9dff4d
set $accentDim   #1c1c1c
set $selection   #454545
set $urgent      #ff4d4d

#                       border         background     text     indicator      child_border
client.focused          $accent        $accent        $bg      $accentDim     $accent
client.focused_inactive #525252        #525252        $fg      #525252        #525252
client.unfocused        $accentDim     $accentDim     $fg      $accentDim     $accentDim
client.urgent           $urgent        $urgent        $bg      $urgent        $urgent
