#!/bin/sh
# Launch sway from GDM on this Intel+NVIDIA laptop.
# All display connectors (eDP-1, DP-1..4) are wired to the Intel GPU, so render on
# Intel only and keep wlroots away from the proprietary NVIDIA driver.
intel=$(readlink -f /dev/dri/by-path/pci-0000:00:02.0-card)
[ -n "$intel" ] && export WLR_DRM_DEVICES="$intel"

export XDG_CURRENT_DESKTOP=sway
export XDG_SESSION_DESKTOP=sway
export MOZ_ENABLE_WAYLAND=1
export QT_QPA_PLATFORM="wayland;xcb"
export _JAVA_AWT_WM_NONREPARENTING=1

# sway refuses to start while the nvidia kernel module is loaded unless told otherwise
exec sway --unsupported-gpu "$@"
